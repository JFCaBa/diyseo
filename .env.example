# Core app + database
# Example local development values:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diyseo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: where the static export renders pages from (default: NEXT_PUBLIC_APP_URL). Use a local address
# such as http://127.0.0.1:3000 if the public URL sits behind a CDN/WAF that blocks self-requests.
# EXPORT_RENDER_ORIGIN=
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SERPER_API_KEY=""
ALLOWED_EMAILS=""
CRON_SECRET=""
AUTO_PUBLISH_INTERVAL_MINUTES="15"
# Comma-separated emails allowed into /admin (matched against the Google sign-in email)
ADMIN_EMAILS=""

# AI provider selection
# Supported text values today: gemini, deepseek
# Configure credentials only for the provider you plan to use.
AI_PROVIDER="gemini"
IMAGE_PROVIDER="qwen"

# Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Qwen image generation
QWEN_API_KEY=""
QWEN_IMAGE_MODEL="wan2.7-image"
LOCAL_UPLOAD_DIR="public/uploads"
PUBLIC_UPLOAD_BASE_URL="/uploads"

# Stripe (sandbox key locally, live key on the server). Webhook secret from
# `stripe listen` locally or the Dashboard endpoint in production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "true" adds Stripe Tax to Checkout; only after Stripe Tax and the OSS registration are set up.
STRIPE_AUTOMATIC_TAX="false"

# Outgoing email (team invites). Without SMTP_HOST invites are not emailed;
# the team page shows the invite link to copy right after each invite.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DIYSEO <info@diyseo.online>"

# Hub SSO for satellite services. A service without both its callback URL and
# its secret (32+ characters) is disabled.
# Ed25519 private JWK (JSON) the hub signs passes with.
SSO_PRIVATE_JWK=""
# Matching public JWK; not read by the hub, documented for the satellites.
SSO_PUBLIC_JWK=""
# Shared secret and callback URL for the MCP service.
SSO_MCP_SECRET=""
SSO_MCP_CALLBACK_URL=""
# Shared secret and callback URL for the Ads service.
SSO_ADS_SECRET=""
SSO_ADS_CALLBACK_URL=""

# Off-site DB backup to Google Drive (optional; see scripts/backup-gdrive-auth.ts).
# OAuth client of type "Desktop"; `npm run backup:gdrive-auth` prints the refresh token AND creates the
# Drive folder (drive.file cannot use a folder made by hand), so FOLDER_ID comes from there too.
BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REFRESH_TOKEN=
BACKUP_GOOGLE_DRIVE_FOLDER_ID=
# Email on backup failure (uses SMTP_*). With BACKUP_OFFSITE_REQUIRED=true the job also exits non-zero
# when Drive is not set up or the upload fails; with false it only logs and alerts.
BACKUP_ALERT_EMAIL=
BACKUP_OFFSITE_REQUIRED=false
