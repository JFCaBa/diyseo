generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String        @id @default(cuid())
  // Mirror of the OWNER WorkspaceMember's userId; keep both in sync.
  ownerId   String        @unique
  name      String        @default("My Workspace")
  // Billing. `plan` is a projection of Stripe (see lib/billing.ts); COMP is never billed.
  plan                     String    @default("TRIAL")
  trialEndsAt              DateTime?
  stripeCustomerId         String?   @unique
  subscriptionStatus       String?
  planSyncedAt             DateTime?
  pendingCheckoutSessionId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sites     SiteProject[]
  aiUsage   AiUsage[]
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
}

// One person belongs to exactly one workspace (userId unique). role: OWNER | MEMBER.
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String   @unique
  role        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Pending invitation; only the sha256 of the URL token is stored.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

// One row per AI article generation or translation; quotas count these per month.
model AiUsage {
  id            String    @id @default(cuid())
  workspaceId   String
  siteProjectId String?
  kind          String
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspace     Workspace?
  membership    WorkspaceMember?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteProject {
  id                         String       @id @default(cuid())
  workspaceId                String
  name                       String
  domain                     String
  autoPublishEnabled         Boolean      @default(false)
  articlesPerWeek            Int          @default(2)
  requireReview              Boolean      @default(true)
  widgetTheme                String?
  widgetInstalledAt          DateTime?
  searchConsolePropertyUrl   String?
  searchConsoleConnectedAt   DateTime?
  defaultSearchCountry       String       @default("es")
  defaultSearchLanguage      String       @default("es")
  translationsEnabled        Boolean      @default(false)
  translationLanguages       String[]     @default([])
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  workspace                  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfile               BrandProfile?
  articles                   Article[]
  keywords                   Keyword[]
  publishingApiKeys          SitePublishingApiKey[]
}

model SitePublishingApiKey {
  id            String      @id @default(cuid())
  siteProjectId String
  label         String
  keyHash       String      @unique
  keyPrefix     String
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  siteProject   SiteProject @relation(fields: [siteProjectId], references: [id], onDelete: Cascade)

  @@index([siteProjectId, revokedAt])
}

model BrandProfile {
  id                      String      @id @default(cuid())
  siteProjectId           String      @unique
  contentLanguage         String?
  businessType            String?
  brandVoiceTone          String?
  targetAudience          String?
  serviceArea             String?
  topicsToAvoid           String?
  keyThemes               String?
  customImageInstructions String?
  imageStyle              String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  siteProject             SiteProject @relation(fields: [siteProjectId], references: [id], onDelete: Cascade)
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String
  excerpt       String?
  coverImageUrl String?
  contentHtml   String
  contentMarkdown String?
  seoTitle      String?
  seoDescription String?
  status        ArticleStatus @default(DRAFT)
  generationSource ArticleGenerationSource @default(MANUAL)
  publishedAt   DateTime?
  siteProjectId String
  keywordId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  siteProject   SiteProject   @relation(fields: [siteProjectId], references: [id], onDelete: Cascade)
  keyword       Keyword?      @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  translations  ArticleTranslation[]

  @@unique([siteProjectId, slug])
  @@index([siteProjectId, status, publishedAt])
}

model ArticleTranslation {
  id             String   @id @default(cuid())
  articleId       String
  language        String
  title           String
  excerpt         String?
  contentMarkdown String
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, language])
  @@index([language])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ArticleGenerationSource {
  MANUAL
  AUTO
}

model Keyword {
  id            String        @id @default(cuid())
  siteProjectId String
  term          String
  status        KeywordStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  siteProject   SiteProject   @relation(fields: [siteProjectId], references: [id], onDelete: Cascade)
  articles      Article[]

  @@unique([siteProjectId, term])
}

enum KeywordStatus {
  NEW
  USED
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      String?
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
}
